<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add data-runonweb-dictation attribute to text fields
         that are good candidates for voice dictation.
         This view is applied to res.partner and res.users forms. -->

    <!-- res.partner: name and phone fields get dictation support -->
    <record id="view_res_partner_stt_dictation" model="ir.ui.view">
        <field name="name">res.partner.stt.dictation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="data-runonweb-dictation">true</attribute>
            </field>
            <field name="phone" position="attributes">
                <attribute name="data-runonweb-dictation">true</attribute>
            </field>
            <field name="street" position="attributes">
                <attribute name="data-runonweb-dictation">true</attribute>
            </field>
        </field>
    </record>

    <!-- res.users: name field gets dictation support -->
    <record id="view_res_users_stt_dictation" model="ir.ui.view">
        <field name="name">res.users.stt.dictation</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="data-runonweb-dictation">true</attribute>
            </field>
        </field>
    </record>
</odoo>
